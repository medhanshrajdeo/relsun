# Copy this file to .env and adjust as needed. .env is gitignored.

# --- Databricks Lakebase (master/golden records + relationship graph,
# both live in the same Postgres-wire-compatible instance — see
# SETUP.md for how to provision one). Native Postgres password auth is
# disabled on Lakebase by default (Databricks warns it exposes the DB to
# the open internet) — DATABASE_URL has no password because the real
# credential is a short-lived OAuth token minted per-connection by
# app/lakebase_auth.py from a Databricks service principal. The username
# here is that service principal's Application ID (also its Postgres
# role name in Lakebase's Roles & Databases UI).
DATABASE_URL=postgresql+psycopg://<service-principal-application-id>@<lakebase-host>:5432/<database>?sslmode=require

DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_CLIENT_ID=<service-principal-application-id>
DATABRICKS_CLIENT_SECRET=<service-principal-oauth-secret>

# --- Backend ---
BACKEND_PORT=8000

# --- Anthropic (Compare summary agent, and the Master Data agent
# hierarchy next — see the Agent Architecture Pivot addendum in
# CONFIGURABLE_WORKFLOWS_AGENTS.md). Leave unset in dev to get a clear
# "not configured" error instead of a crash.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
