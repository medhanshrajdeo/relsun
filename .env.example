# Copy this file to .env and adjust as needed. .env is gitignored.

# --- Postgres (master/golden records + pgvector) ---
POSTGRES_USER=relsun
POSTGRES_PASSWORD=relsun_dev_password
POSTGRES_DB=relsun
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://relsun:relsun_dev_password@localhost:5433/relsun

# --- Neo4j (relationship graph) ---
NEO4J_USER=neo4j
NEO4J_PASSWORD=relsun_dev_password
NEO4J_URI=bolt://localhost:7687

# --- Backend ---
BACKEND_PORT=8000

# --- Anthropic (Compare summary agent, and the Master Data agent
# hierarchy next — see the Agent Architecture Pivot addendum in
# CONFIGURABLE_WORKFLOWS_AGENTS.md). Leave unset in dev to get a clear
# "not configured" error instead of a crash.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
