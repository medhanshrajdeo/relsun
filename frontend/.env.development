# Loaded by `next dev` only (NODE_ENV=development). Committed on purpose
# (see .gitignore opt-in) so local dev has a working default without anyone
# needing a personal .env.local.
#
# Local dev runs the FastAPI backend separately on :8000, so the browser
# calls it directly cross-port.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
