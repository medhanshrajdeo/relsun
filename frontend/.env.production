# Loaded by `next build` (NODE_ENV=production). Committed on purpose
# (see .gitignore opt-in) so ANY production build is correct by default,
# not just one run with the right shell env var.
#
# Relsun deploys as ONE Databricks App: the Next.js server and FastAPI run
# in the same container, and next.config.ts rewrites proxy /auth /search
# /graph /concierge /requests ... to FastAPI on localhost:8001 internally.
# So the browser must call same-origin paths, never an absolute backend URL.
# "same-origin" is the explicit sentinel for "" — see src/lib/api.ts.
NEXT_PUBLIC_API_BASE_URL=same-origin
